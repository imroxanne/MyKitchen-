  "steps": [
    {
      "text": "Разогреть духовку до 150–180 °C.",
      "minutes": null
    },
    {
      "text": "Взбить яйца с сахаром, содой и сметаной.",
      "minutes": null
    },
    {
      "text": "Всыпать муку и снова взбить до однородности.",
      "minutes": null
