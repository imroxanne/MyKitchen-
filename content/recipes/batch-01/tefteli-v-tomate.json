  "steps": [
    {
      "text": "Приготовить мясной фарш, добавить мелко нарезанный зелёный лук (или натёртую головку репчатого) и хорошо перемешать.",
      "minutes": null
    },
    {
      "text": "Сформовать шарики по 20–30 г, обвалять в муке и обжарить со всех сторон в масле на разогретой сковороде.",
      "minutes": null
    },
    {
      "text": "Переложить тефтели в неглубокую кастрюлю, добавить томат-пюре, бульон, лавровый лист, перец горошком и растёртый с солью чеснок.",
      "minutes": null
    },
    {
      "text": "Накрыть крышкой и тушить на слабом огне 10–20 минут.",
      "minutes": 20
    },
    {
      "text": "Посолить, добавить ложечку острого томатного соуса. Подавать, посыпав рубленой петрушкой, с рисом, гречкой или картофелем.",
      "minutes": null
    }
  ]
