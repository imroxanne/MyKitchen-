# Скопируйте в .env.local (он не попадает в Git) и заполните.
# Все VITE_* значения попадают в браузер — сюда нельзя класть секреты
# (service_role, пароли БД, токены). Публикуемый ключ Supabase безопасен
# для браузера: доступ к данным ограничивают политики RLS в БД.

# local | preview | production | test
VITE_APP_ENV=local

# Локальный Supabase (`npm run db:start`, значения из `npm run db:status`):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY из вывода db:status>
# Облачный проект mykitchen: Supabase → Project Settings → API Keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
